{
  "uid": "owntone",
  "server_name": "owntone-mini",
  "loglevel": 3,
  "logfile": "/var/log/owntone.log",
  "pipe_path": "/run/autostream-pipes/autostream.fifo",
  "pipe_autostart": true,
  "pipe_sample_rate": 44100,
  "pipe_bits_per_sample": 16,
  "resample_quality": "standard",
  "ipv6": true,
  "start_buffer_ms": 2250,
  "uncompressed_alac": true,
  "buffered_audio_enabled": true,
  "buffered_encoder_budget": 0,
  "tv_proxy_leader_audio_suppress": true,
  "device_removal_grace_period": 180,
  "airplay_timing_port": 0,
  "airplay_control_port": 0,
  "trusted_networks": [
    "lan"
  ],
  "airplay_devices": {}
}
