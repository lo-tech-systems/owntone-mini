[Unit]
Description=Minimal Owntone daemon. Provides pipe (FIFO) input to AirPlay(2) outputs.
Documentation=man:owntone(8)
Requires=network.target local-fs.target avahi-daemon.socket
After=network-online.target remote-fs.target

[Service]
ExecStart=@sbindir@/owntone -f

# The notifier socket lives here; the daemon runs unprivileged and cannot make
# the directory itself.
ExecStartPre=/usr/bin/install -d -m 0755 -o @OWNTONE_USER@ -g @OWNTONE_GROUP@ /run/owntone-mini

# Media path must outrank default-priority housekeeping; see
# the companion audio service for the rest of the ladder.
Nice=-12

# Allow the process to lock its pages in RAM (mlockall(), done once it has
# dropped root) so the audio threads don't stall on page faults under
# memory pressure.
LimitMEMLOCK=infinity

# Bounds glibc to two malloc heaps so freed memory consolidates and can be
# returned to the system instead of spreading across per-thread arenas.
Environment=MALLOC_ARENA_MAX=2

# Freeze glibc's dynamic malloc thresholds low. Without this, freeing a large
# transient allocation (an artwork push, an ffmpeg table) ratchets the mmap
# threshold up to tens of MiB, after which later large buffers are carved from
# the arena and their freed space is never returned to the OS. Frozen low, such
# buffers are mmap'd and released individually on free, and top-of-heap free
# space is handed back at 128 KiB granularity. NB: on 32-bit builds the mmap
# threshold maxes out at 512 KiB, so this exact value only fully applies on
# 64-bit; a smaller effective value there only trims more eagerly (harmless).
Environment=MALLOC_MMAP_THRESHOLD_=131072
Environment=MALLOC_TRIM_THRESHOLD_=131072

# Restart, but set a limit so we don't restart indefinitely. Unfortunately,
# systemd also applies the start limits to manual restarts, so that's why the
# burst value allows for 10 restarts.
Restart=on-failure
RestartSec=5
StartLimitBurst=10
StartLimitInterval=600

[Install]
WantedBy=multi-user.target
